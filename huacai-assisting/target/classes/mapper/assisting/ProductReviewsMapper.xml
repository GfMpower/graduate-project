<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.huacai.assisting.mapper.ProductReviewsMapper">

    <resultMap type="ProductReviews" id="ProductReviewsResult">
        <result property="reviewId"    column="review_id"    />
        <result property="productsId"    column="products_id"    />
        <result property="userId"    column="user_id"    />
        <result property="content"    column="content"    />
        <result property="rating"    column="rating"    />
        <result property="createTime"    column="create_time"    />
        <result property="userName"    column="user_name"    />
    </resultMap>

    <sql id="selectProductReviewsVo">
        select pr.review_id, pr.products_id, pr.user_id, pr.content, pr.rating, pr.create_time, u.nick_name as user_name 
        from product_reviews pr
        left join sys_user u on pr.user_id = u.user_id
    </sql>

    <select id="selectProductReviewsList" parameterType="ProductReviews" resultMap="ProductReviewsResult">
        <include refid="selectProductReviewsVo"/>
        <where>
            <if test="productsId != null  and productsId != ''"> and pr.products_id = #{productsId}</if>
            <if test="userId != null  and userId != ''"> and pr.user_id = #{userId}</if>
            <if test="content != null  and content != ''"> and pr.content like concat('%', #{content}, '%')</if>
        </where>
        order by pr.create_time desc
    </select>

    <select id="selectProductReviewsByReviewId" parameterType="String" resultMap="ProductReviewsResult">
        <include refid="selectProductReviewsVo"/>
        where pr.review_id = #{reviewId}
    </select>

    <insert id="insertProductReviews" parameterType="ProductReviews">
        insert into product_reviews
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="reviewId != null">review_id,</if>
            <if test="productsId != null and productsId != ''">products_id,</if>
            <if test="userId != null and userId != ''">user_id,</if>
            <if test="content != null and content != ''">content,</if>
            <if test="rating != null">rating,</if>
            <if test="createTime != null">create_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="reviewId != null">#{reviewId},</if>
            <if test="productsId != null and productsId != ''">#{productsId},</if>
            <if test="userId != null and userId != ''">#{userId},</if>
            <if test="content != null and content != ''">#{content},</if>
            <if test="rating != null">#{rating},</if>
            <if test="createTime != null">#{createTime},</if>
         </trim>
    </insert>

    <update id="updateProductReviews" parameterType="ProductReviews">
        update product_reviews
        <trim prefix="SET" suffixOverrides=",">
            <if test="content != null and content != ''">content = #{content},</if>
            <if test="rating != null">rating = #{rating},</if>
        </trim>
        where review_id = #{reviewId}
    </update>

    <delete id="deleteProductReviewsByReviewIds" parameterType="String">
        delete from product_reviews where review_id in
        <foreach item="reviewId" collection="array" open="(" separator="," close=")">
            #{reviewId}
        </foreach>
    </delete>
</mapper>