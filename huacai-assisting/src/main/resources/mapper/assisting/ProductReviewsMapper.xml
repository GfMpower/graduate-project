<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.huacai.assisting.mapper.ProductReviewsMapper">
    
    <resultMap type="ProductReviews" id="ProductReviewsResult">
        <result property="reviewId" column="review_id"/>
        <result property="productsId" column="products_id"/>
        <result property="userId" column="user_id"/>
        <result property="orderId" column="order_id"/>
        <result property="farmersUserId" column="farmers_user_id"/>
        <result property="content" column="content"/>
        <result property="rating" column="rating"/>
        <result property="replyContent" column="reply_content"/>
        <result property="replyTime" column="reply_time"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
        <!-- 扩展字段 -->
        <result property="productName" column="product_name"/>
        <result property="userName" column="user_name"/>
    </resultMap>

    <sql id="selectProductReviewsVo">
        SELECT 
            r.review_id,
            r.products_id,
            r.user_id,
            r.order_id,
            r.farmers_user_id,
            r.content,
            r.rating,
            r.reply_content,
            r.reply_time,
            r.status,
            r.create_time,
            p.name as product_name,
            u.nick_name as user_name
        FROM product_reviews r
        LEFT JOIN products p ON r.products_id = p.products_id
        LEFT JOIN sys_user u ON r.user_id = u.user_id
    </sql>

    <select id="selectProductReviewsList" parameterType="ProductReviews" resultMap="ProductReviewsResult">
        <include refid="selectProductReviewsVo"/>
        <where>
            <if test="productsId != null and productsId != ''">
                AND r.products_id = #{productsId}
            </if>
            <if test="userId != null and userId != ''">
                AND r.user_id = #{userId}
            </if>
            <if test="orderId != null and orderId != ''">
                AND r.order_id = #{orderId}
            </if>
            <if test="farmersUserId != null and farmersUserId != ''">
                AND r.farmers_user_id = #{farmersUserId}
            </if>
            <if test="status != null">
                AND r.status = #{status}
            </if>
        </where>
        ORDER BY r.create_time DESC
    </select>
    
    <select id="selectProductReviewsByReviewId" parameterType="String" resultMap="ProductReviewsResult">
        <include refid="selectProductReviewsVo"/>
        WHERE r.review_id = #{reviewId}
    </select>

    <insert id="insertProductReviews" parameterType="ProductReviews">
        INSERT INTO product_reviews (
            review_id,
            products_id,
            user_id,
            order_id,
            farmers_user_id,
            content,
            rating,
            reply_content,
            reply_time,
            status,
            create_time
        ) VALUES (
            #{reviewId},
            #{productsId},
            #{userId},
            #{orderId},
            #{farmersUserId},
            #{content},
            #{rating},
            #{replyContent},
            #{replyTime},
            #{status},
            #{createTime}
        )
    </insert>

    <update id="updateProductReviews" parameterType="ProductReviews">
        UPDATE product_reviews
        <set>
            <if test="replyContent != null">reply_content = #{replyContent},</if>
            <if test="replyTime != null">reply_time = #{replyTime},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        WHERE review_id = #{reviewId}
    </update>

    <delete id="deleteProductReviewsByReviewId" parameterType="String">
        DELETE FROM product_reviews WHERE review_id = #{reviewId}
    </delete>

    <delete id="deleteProductReviewsByReviewIds" parameterType="String">
        DELETE FROM product_reviews WHERE review_id IN 
        <foreach item="reviewId" collection="array" open="(" separator="," close=")">
            #{reviewId}
        </foreach>
    </delete>
</mapper>
